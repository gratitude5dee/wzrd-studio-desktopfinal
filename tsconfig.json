{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "noImplicitAny": false,
    "noEmit": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@qcut-app/*": [
        "./src/qcut/app/*"
      ],
      "@qcut/editor-core": [
        "./src/qcut/editor-core/index.ts"
      ],
      "@qcut/platform-core": [
        "./src/qcut/platform/core/index.ts"
      ],
      "@qcut/platform-web": [
        "./src/qcut/platform/web/index.ts"
      ],
      "@qcut/platform-desktop": [
        "./src/qcut/platform/desktop/index.ts"
      ],
      "react-dnd": [
        "./src/lib/react-dnd"
      ]
    },
    "skipLibCheck": true,
    "strictNullChecks": false,
    "target": "ES2022"
  },
  "files": [],
  "references": [
    {
      "path": "./tsconfig.app.json"
    },
    {
      "path": "./tsconfig.node.json"
    }
  ],
  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx"
  ],
  "exclude": [
    "src/**/__tests__/**",
    "src/**/__tests_disabled__/**",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/*.spec.ts",
    "src/**/*.spec.tsx",
    "supabase/functions"
  ]
}
