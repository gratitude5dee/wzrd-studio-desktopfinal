{
  "name": "vite_react_shadcn_ts",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "web:dev": "next dev --webpack",
    "web:build": "next build --webpack",
    "web:start": "next start",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "lint": "eslint . && bun run check:web-boundaries",
    "check:web-boundaries": "node scripts/check-web-boundaries.mjs",
    "test": "NODE_OPTIONS=--require=./scripts/test/register-canvas-stub.cjs vitest run",
    "preview": "vite preview",
    "desktop:dev": "node scripts/desktop-dev.mjs",
    "desktop:build": "bun run build",
    "desktop:dist:mac": "bun run desktop:build && bun x electron-builder --mac dir --arm64 && node scripts/build-apfs-dmg.mjs",
    "desktop:test": "bun run desktop:build && playwright test -c playwright.electron.config.ts",
    "test:e2e": "VITE_USE_MOCK_ASSETS=true VITE_BYPASS_AUTH_FOR_TESTS=true playwright test tests/e2e tests/performance.spec.ts",
    "test:e2e:web": "playwright test -c playwright.web.config.ts",
    "test:e2e:pwa": "bun run web:build && playwright test -c playwright.pwa.config.ts",
    "test:daytona-relay": "bun run --cwd packages/wzrd-agent-relay test",
    "check:daytona-relay": "bun run --cwd packages/wzrd-agent-relay typecheck",
    "remotion:preview": "remotion preview",
    "remotion:render": "remotion render"
  },
  "build": {
    "appId": "com.wzrd.studio",
    "productName": "WZRD Studio",
    "artifactName": "wzrdstudiofinal555.${ext}",
    "afterPack": "scripts/electron-builder-afterPack.mjs",
    "asar": true,
    "asarUnpack": [
      "node_modules/node-pty/**"
    ],
    "npmRebuild": false,
    "files": [
      "dist/**",
      "electron/**",
      "build/icon.icns",
      "package.json",
      "agent-skills/**",
      "node_modules/node-pty/**"
    ],
    "directories": {
      "output": "release"
    },
    "protocols": [
      {
        "name": "WZRD Studio",
        "schemes": [
          "wzrd"
        ]
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.video",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "identity": null,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "WZRD Studio uses the microphone for realtime voice commands and voice-assisted creative workflows.",
        "NSCameraUsageDescription": "WZRD Studio may request camera access for wallet, passkey, or future capture workflows."
      }
    },
    "dmg": {
      "artifactName": "wzrdstudiofinal555.${ext}"
    }
  },
