{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleDetection": "force",
    "moduleResolution": "bundler",
    "noEmit": true,
    "noFallthroughCasesInSwitch": false,
    "noImplicitAny": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@qcut-app/*": [
        "./src/qcut/app/*"
      ],
      "@qcut/editor-core": [
        "./src/qcut/editor-core/index.ts"
      ],
      "@qcut/platform-core": [
        "./src/qcut/platform/core/index.ts"
      ],
      "@qcut/platform-web": [
        "./src/qcut/platform/web/index.ts"
      ],
      "@qcut/platform-desktop": [
        "./src/qcut/platform/desktop/index.ts"
      ],
      "react-dnd": [
        "./src/lib/react-dnd"
      ]
    },
    "skipLibCheck": true,
    "strict": false,
    "target": "ES2022",
    "useDefineForClassFields": true
  },
  "include": [
    "next-env.d.ts",
    "src",
    "shared"
  ],
  "exclude": [
    "supabase/functions"
  ]
}
